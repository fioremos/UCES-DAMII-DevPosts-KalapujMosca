@startuml flujo_navegacion_parametros
autonumber
actor Usuario
boundary MainPage as "MainPage (UI)"
control MainViewModel as "MainViewModel"
entity Shell as "Shell.Current"
boundary DetallePage as "DetallePage (UI)"
control DetalleViewModel as "DetalleViewModel"

== Navegación hacia el Detalle ==
Usuario -> MainPage : Toca tarjeta de publicación (SelectionChanged)
MainPage -> MainViewModel : Ejecuta SeleccionarPostCommand(post)
activate MainViewModel

note over MainViewModel
  Instancia ShellNavigationQueryParameters (parametros)
  con clave "PostSeleccionado" y referencia a post
end note

MainViewModel -> Shell : GoToAsync("DetallePage", parametros)
deactivate MainViewModel

Shell -> DetallePage : Resuelve e inicializa (DI)
Shell -> DetalleViewModel : ApplyQueryAttributes(query)
activate DetalleViewModel
DetalleViewModel -> DetalleViewModel : Extrae "PostSeleccionado" y asigna a Post
DetalleViewModel --> DetallePage : Notifica cambio vía PropertyChanged
deactivate DetalleViewModel

DetallePage --> Usuario : Renderiza publicación completa (Id, Autor, Title, Body)

== Retorno al Listado ==
Usuario -> DetallePage : Toca "← Volver al Listado"
DetallePage -> DetalleViewModel : Ejecuta VolverCommand
activate DetalleViewModel
DetalleViewModel -> Shell : GoToAsync("..")
deactivate DetalleViewModel

Shell -> MainPage : Regresa al tope de la pila
MainPage --> Usuario : Mantiene listado y estado previo intactos
@enduml