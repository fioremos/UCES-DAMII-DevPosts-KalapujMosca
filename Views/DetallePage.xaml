<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:DevPostsApp.ViewModels"
             x:Class="DevPostsApp.Views.DetallePage"
             x:DataType="vm:DetalleViewModel"
             Title="Detalle de Publicación"
             BackgroundColor="{AppThemeBinding Light=#F4F6F9, Dark=#0D1117}">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">

            <!-- Botón Volver superior -->
            <Button Text="← Volver al Listado"
                    Command="{Binding VolverCommand}"
                    HorizontalOptions="Start"
                    BackgroundColor="Transparent"
                    TextColor="#2563EB"
                    FontAttributes="Bold"
                    Padding="0" />

            <!-- Tarjeta de Contenido Completo -->
            <Border StrokeShape="RoundRectangle 12"
                    Stroke="{AppThemeBinding Light=#E5E7EB, Dark=#30363D}"
                    StrokeThickness="1"
                    BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#161B22}"
                    Padding="20">

                <VerticalStackLayout Spacing="14">

                    <!-- Metadatos: ID y Autor (Formateados en XAML) -->
                    <HorizontalStackLayout Spacing="12">
                        <Border StrokeShape="RoundRectangle 6"
                                BackgroundColor="#DBEAFE"
                                Padding="8,4"
                                StrokeThickness="0">
                            <Label Text="{Binding Post.Id, StringFormat='Publicación #{0}'}"
                                   FontSize="12"
                                   FontAttributes="Bold"
                                   TextColor="#1D4ED8" />
                        </Border>

                        <Border StrokeShape="RoundRectangle 6"
                                BackgroundColor="{AppThemeBinding Light=#F3F4F6, Dark=#21262D}"
                                Padding="8,4"
                                StrokeThickness="0">
                            <Label Text="{Binding Post.UserId, StringFormat='Usuario ID: {0}'}"
                                   FontSize="12"
                                   TextColor="{AppThemeBinding Light=#4B5563, Dark=#9CA3AF}" />
                        </Border>
                    </HorizontalStackLayout>

                    <!-- Título -->
                    <Label Text="{Binding Post.Title}"
                           FontSize="20"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light=#111827, Dark=#F9FAFB}" />

                    <BoxView HeightRequest="1"
                             Color="{AppThemeBinding Light=#E5E7EB, Dark=#30363D}" />

                    <!-- Encabezado de contenido -->
                    <Label Text="Contenido del artículo:"
                           FontSize="12"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light=#6B7280, Dark=#8B949E}" />

                    <!-- Cuerpo completo -->
                    <Label Text="{Binding Post.Body}"
                           FontSize="15"
                           LineHeight="1.4"
                           TextColor="{AppThemeBinding Light=#374151, Dark=#D1D5DB}" />

                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>