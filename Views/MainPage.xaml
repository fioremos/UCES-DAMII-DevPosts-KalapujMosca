<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:DevPostsApp.ViewModels"
             xmlns:models="clr-namespace:DevPostsApp.Models"
             x:Class="DevPostsApp.Views.MainPage"
             x:DataType="viewmodels:MainViewModel"
             Title="DevPosts Reader">

    <Grid RowDefinitions="Auto,Auto,Auto,*" Padding="16" RowSpacing="12">

        <!-- Barra de acciones principales -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="10">
            <Button Grid.Column="0"
                    Text="Sincronizar Posts"
                    Command="{Binding CargarPostsCommand}"
                    IsEnabled="{Binding NoEstaOcupado}" />

            <Button Grid.Column="1"
                    Text="+ Nuevo Post"
                    Command="{Binding AlternarFormularioCommand}"
                    BackgroundColor="#2B5B84"
                    TextColor="White" />
        </Grid>

        <!-- Formulario colapsable para alta local con validación y hardware -->
        <Frame Grid.Row="1"
               IsVisible="{Binding MostrarFormulario}"
               Padding="12"
               CornerRadius="8"
               BorderColor="#CCCCCC">
            <VerticalStackLayout Spacing="8">
                <Label Text="Nueva Publicación Local" FontAttributes="Bold" FontSize="15" />
                <Entry Placeholder="Título (mínimo 5 caracteres)"
                       Text="{Binding NuevoTitulo}" />
                <Editor Placeholder="Contenido de la publicación (mínimo 10 caracteres)"
                        Text="{Binding NuevoCuerpo}"
                        HeightRequest="80" />

                <!-- Acciones de Hardware: Cámara/Galería y Ubicación GPS -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                    <Button Grid.Column="0"
                            Text="Adjuntar Foto"
                            Command="{Binding AdjuntarFotoCommand}"
                            IsEnabled="{Binding NoEstaOcupado}"
                            BackgroundColor="#4A6572"
                            TextColor="White" />
                    <Button Grid.Column="1"
                            Text="Ubicación GPS"
                            Command="{Binding CapturarUbicacionCommand}"
                            IsEnabled="{Binding NoEstaOcupado}"
                            BackgroundColor="#4A6572"
                            TextColor="White" />
                </Grid>

                <!-- Vista previa de foto adjunta y coordenadas capturadas -->
                <Image Source="{Binding RutaImagenAdjunta}"
                       IsVisible="{Binding TieneImagenAdjunta}"
                       HeightRequest="120"
                       Aspect="AspectFit" />

                <Label Text="{Binding UbicacionCapturada, StringFormat='Ubicación: {0}'}"
                       IsVisible="{Binding TieneUbicacion}"
                       FontSize="12"
                       TextColor="Teal"
                       FontAttributes="Bold" />

                <Button Text="Guardar en SQLite"
                        Command="{Binding CrearPostCommand}"
                        IsEnabled="{Binding NoEstaOcupado}"
                        BackgroundColor="SeaGreen"
                        TextColor="White" />
            </VerticalStackLayout>
        </Frame>

        <!-- Indicador de estado y errores -->
        <HorizontalStackLayout Grid.Row="2" Spacing="8" VerticalOptions="Center">
            <ActivityIndicator IsRunning="{Binding EstaOcupado}"
                               IsVisible="{Binding EstaOcupado}"
                               HeightRequest="20"
                               WidthRequest="20" />
            <Label Text="{Binding MensajeEstado}"
                   TextColor="{Binding ColorEstado}"
                   FontSize="13"
                   LineBreakMode="WordWrap" />
        </HorizontalStackLayout>

        <!-- Listado de publicaciones -->
        <CollectionView Grid.Row="3"
                        ItemsSource="{Binding Posts}"
                        SelectionMode="None">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Post">
                    <Frame Margin="0,0,0,10" Padding="12" CornerRadius="8">
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:MainViewModel}}, Path=SeleccionarPostCommand}"
                                CommandParameter="{Binding .}" />
                        </Frame.GestureRecognizers>
                        <VerticalStackLayout Spacing="4">
                            <Label Text="{Binding Title}"
                                   FontAttributes="Bold"
                                   FontSize="15"
                                   LineBreakMode="TailTruncation" />
                            <Label Text="{Binding Body}"
                                   FontSize="13"
                                   TextColor="Gray"
                                   MaxLines="2"
                                   LineBreakMode="TailTruncation" />
                        </VerticalStackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>
</ContentPage>